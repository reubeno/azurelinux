index 97e2fff..a2d8c1f 100644
--- a/glib/ghmac.c
+++ b/glib/ghmac.c
@@ -35,6 +35,9 @@
 #include "gtypes.h"
 #include "glibintl.h"
 
+#ifdef USE_OPENSSL
+#error "build configuration error"
+#endif
 
 /**
  * GHmac:
@@ -89,6 +92,18 @@ struct _GHmac
  * Support for digests of type %G_CHECKSUM_SHA512 has been added in GLib 2.42.
  * Support for %G_CHECKSUM_SHA384 was added in GLib 2.52.
  *
+ * Note that #GHmac creation may fail, in which case this function will
+ * return %NULL. Since there is no error parameter, it is not possible
+ * to indicate why.
+ *
+ * In Azure Linux, GLib is configured to use OpenSSL to implement #GHmac
+ * in order to support FIPS compliance through the system's reference
+ * crypto provider. This introduces additional failure possibilities
+ * that are not present in upstream GLib. For example, the creation of
+ * a #GHmac will fail if @digest_type is %G_CHECKSUM_MD5 and the system
+ * is running in FIPS mode. #GHmac creation may also fail if GLib is
+ * unable to load OpenSSL.
+ *
  * Returns: (nullable) (transfer full): the newly created #GHmac, or %NULL.
  *   Use g_hmac_unref() to free the memory allocated by it.
  *
@@ -356,115 +371,3 @@ g_hmac_get_digest (GHmac  *hmac,
   g_checksum_update (hmac->digesto, buffer, len_signed);
   g_checksum_get_digest (hmac->digesto, buffer, digest_len);
 }
